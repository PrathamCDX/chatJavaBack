# Copy to .env and fill in. .env is git-ignored; this file is the template that gets committed.
# Every variable has a fallback in application.properties, so only override what differs.

SERVER_PORT=8080

# Database: SQLite file, created on first start. Keep ?foreign_keys=true (SQLite ignores FKs otherwise).
# On a server, use a path on a disk that survives redeploys, e.g. jdbc:sqlite:/var/lib/demo/javademo.db?foreign_keys=true
DB_URL=jdbc:sqlite:./javademo.db?foreign_keys=true

# JPA: use "validate" or "none" on shared servers so Hibernate never changes the schema on its own
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# JWT: the secret must be random and at least 32 bytes; generate one with: openssl rand -base64 48
# Changing it logs everyone out (existing tokens stop verifying)
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-bytes
JWT_EXPIRATION_MS=86400000
JWT_COOKIE_NAME=token
JWT_COOKIE_SECURE=false

# WebSocket (/ws/chat)
# Browser origins allowed to connect, comma-separated; [*] matches any port. Set to the frontend's URL on a server.
WS_ALLOWED_ORIGINS=http://localhost:[*]
# Ping every client this often; close one that has sent nothing for the idle timeout (keep it 2-3x the interval)
WS_HEARTBEAT_INTERVAL_MS=30000
WS_IDLE_TIMEOUT_MS=75000
